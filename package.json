{
  "name": "veil",
  "version": "0.1.0",
  "description": "Private XRP/USDC payments on XRPL using zero-knowledge cryptography",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "hardhat": "hardhat",
    "hardhat:compile": "hardhat compile",
    "hardhat:test": "hardhat test",
    "hardhat:deploy:local": "hardhat run scripts/deploy.cjs --network localhost",
    "hardhat:deploy:devnet": "hardhat run scripts/deploy.cjs --network xrplEvmDevnet",
    "hardhat:deploy:testnet": "hardhat run scripts/deploy.cjs --network xrplEvmTestnet",
    "hardhat:node": "hardhat node",
    "deploy": "./deploy.sh",
    "deploy:staging": "./deploy.sh staging",
    "deploy:production": "./deploy.sh production",
    "docker:build": "docker build -t veil-privacy --platform linux/amd64 .",
    "docker:run": "docker run -p 8080:8080 veil-privacy"
  },
  "dependencies": {
    "@axelar-network/axelarjs-sdk": "^0.16.1",
    "@gemwallet/api": "^3.8.0",
    "ethers": "^6.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "snarkjs": "^0.7.6",
    "xrpl": "^4.5.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "circomlibjs": "^0.1.7",
    "dotenv": "^17.2.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "hardhat": "^2.28.4",
    "jsdom": "^25.0.0",
    "poseidon-solidity": "^0.0.5",
    "postcss": "^8.4.47",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}

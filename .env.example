# Veil Private XRP Payments - Environment Variables
# Copy this to .env and fill in your values

# ===== DEPLOYMENT =====
# Private key for contract deployment (DO NOT COMMIT!)
# PRIVATE_KEY=0x...

# ===== NETWORKS =====
# XRPL EVM Sidechain RPC URLs (defaults provided in hardhat.config.cjs)
# XRPL_EVM_TESTNET_RPC=https://rpc-evm-sidechain.peersyst.tech
# XRPL_EVM_MAINNET_RPC=https://rpc.xrpl-evm.com

# ===== VERIFICATION =====
# Explorer API key for contract verification
# EXPLORER_API_KEY=

# ===== GAS REPORTING =====
# Enable gas reporting in tests
# REPORT_GAS=true
# COINMARKETCAP_API_KEY=

# ===== NOTES =====
# 1. Get testnet XRP from: https://faucet.xrpl-evm.peersyst.tech
# 2. NEVER commit your actual .env file
# 3. Keep private keys secure - use hardware wallet for production


xrpl_evm_private_key=82325f8ad49256a3f12ab1fcaf39f9591ce1c8ed0e66b268ddb60c185040fb0e